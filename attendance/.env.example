# ─────────────────────────────────────────────────────────────
# 왓츠앱 출퇴근 관리 시스템 환경변수
# 이 파일을 .env 로 복사한 뒤 값을 채우세요. (.env 는 커밋 금지)
# ─────────────────────────────────────────────────────────────

# ── 기본 ──────────────────────────────────────────────────────
# 배포 후 실제 https 주소. Twilio 서명 검증에 URL이 포함되므로 정확해야 함
PUBLIC_BASE_URL=http://localhost:8000
TIMEZONE=Asia/Seoul
DATABASE_URL=sqlite:///./attendance.db
MEDIA_DIR=./media

# ── 관리자 대시보드 (HTTP Basic) ───────────────────────────────
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-now

# ── Twilio (WhatsApp Business API) ────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
# 운영에서는 반드시 true. false 로 두면 누구나 webhook 위조 가능
TWILIO_VALIDATE_SIGNATURE=true

# ── OCR ───────────────────────────────────────────────────────
# 시도 순서. 앞에서 성공하면 뒤는 호출하지 않음
OCR_PROVIDERS=tesseract,claude
# 이 값 미만이면 다음 provider 로 넘어감 (0.0 ~ 1.0)
OCR_MIN_CONFIDENCE=0.6
# 보드 시각이 항상 우측 상단이면 해당 영역만 잘라 인식 (left,top,right,bottom 비율)
# 예: 0.45,0,1,0.35  / 비우면 전체 이미지 사용
OCR_CROP=

# Tesseract
TESSERACT_CMD=

# Claude Vision 폴백
ANTHROPIC_API_KEY=
OCR_CLAUDE_MODEL=claude-opus-5
# 비용 우선이면: OCR_CLAUDE_MODEL=claude-haiku-4-5

# ── 판별 규칙 ─────────────────────────────────────────────────
# 보드 날짜 표기 순서: MDY(8/14/2026) 또는 DMY(14/8/2026)
DATE_ORDER=MDY
# 이 시각 이전은 전날 근무로 귀속 (야간근무 대응)
DAY_CUTOFF_HOUR=4
# 이 분(minute) 이내 연속 사진은 중복으로 간주
DEDUPE_MINUTES=10
# 근무시간이 이 시간을 넘으면 anomaly 로 표시
MAX_SHIFT_HOURS=16
# OCR 시각이 수신 시각과 이만큼 이상 벌어지면 검토 플래그
SANITY_WINDOW_HOURS=48
