# analysis 커넥터용 환경변수 (--fetch 실행 시에만 필요).
# 분석 엔진 자체(python run.py --sample / --data)는 키가 전혀 필요 없다.
#
# 사용법:  cp .env.example .env  후 값 채우고  →  set -a; . ./.env; set +a; python run.py --fetch
# (스토어프론트 .env.local 의 INSTAGRAM_* / META_* 값을 그대로 재사용해도 된다.)

# --- MakeShop Open API (주문/상품 수집) ---
MAKESHOP_API_BASE=https://openapi.makeshop.co.kr
MAKESHOP_API_KEY=            # 상점별 발급 키 (MakeShop 관리자 > 오픈API 메뉴)
MAKESHOP_SHOP_ID=

# --- Meta Graph API (인스타 콘텐츠 인사이트 + 팔로워 인구통계) ---
META_GRAPH_VERSION=v19.0
INSTAGRAM_ACCESS_TOKEN=      # 스토어프론트와 동일
INSTAGRAM_USER_ID=17841436592849949

# --- Meta Marketing API (광고 성과 — 선택. 권한/토큰 별도) ---
META_MARKETING_TOKEN=
META_AD_ACCOUNT_ID=          # act_ 접두 없이 숫자만

# --- 분석 파라미터 오버라이드 (선택) ---
# ABC_RECENT_DAYS=90
# ABC_TOP_RESTOCK=8
# ABC_TOP_NEW=6
